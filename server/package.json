{
  "name": "shengji-server",
  "private": true,
  "version": "0.1.0",
  "description": "Online multiplayer server for Shengji (Cloudflare Worker shengji-online): Hub and GameRoom Durable Objects over a TypeScript port of the Swift engine, proven identical by generated test vectors.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "dev": "wrangler dev",
    "e2e": "node --experimental-strip-types scripts/e2e.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "wrangler": "4.144.0"
  }
}
